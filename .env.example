APP_NAME="Perfumes Collection"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://perfumescollection.pk

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Hostinger MySQL Database Settings
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=u123456789_perfumes_pk
DB_USERNAME=u123456789_admin
DB_PASSWORD=your_hostinger_mysql_password

# Hostinger Shared Hosting Queue & Cache Configuration (CRITICAL: Database Queue + File Cache)
BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Hostinger Mail / Titan Email / SMTP Configuration
MAIL_MAILER=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=concierge@perfumescollection.pk
MAIL_PASSWORD=your_email_password
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="concierge@perfumescollection.pk"
MAIL_FROM_NAME="Perfumes Collection Haute Parfumerie"

# Store Brand & WhatsApp Concierge
STORE_NAME="Perfumes Collection"
STORE_PHONE="+92 300 1234567"
STORE_WHATSAPP="923001234567"
STORE_EMAIL="concierge@perfumescollection.pk"
STORE_CURRENCY="PKR"
FREE_SHIPPING_THRESHOLD=4999
DEFAULT_SHIPPING_COST=250

# Pluggable Payment Gateways - Master Toggles
GATEWAY_COD_ENABLED=true
GATEWAY_BANK_TRANSFER_ENABLED=true
GATEWAY_WALLET_TRANSFER_ENABLED=true
GATEWAY_JAZZCASH_ENABLED=true
GATEWAY_EASYPAISA_ENABLED=true
GATEWAY_SAFEPAY_ENABLED=true
PAYMENT_SKIP_HASH_VERIFICATION=false

# 1. Direct Bank Transfer & Raast Details
BANK_NAME="Bank Alfalah Limited"
BANK_ACCOUNT_TITLE="Perfumes Collection (Pvt) Ltd"
BANK_ACCOUNT_NUMBER="0142-1007894561"
BANK_IBAN="PK36ALFH01421007894561"
BANK_RAAST_ID="03001234567"
BANK_BRANCH="Main Boulevard Gulberg III, Lahore"

# 2. Manual Mobile Wallets (Personal / Business accounts)
EASYPAISA_ACCOUNT_TITLE="Perfumes Collection"
EASYPAISA_NUMBER="03001234567"
JAZZCASH_ACCOUNT_TITLE="Perfumes Collection"
JAZZCASH_NUMBER="03001234567"
SADAPAY_ACCOUNT_TITLE="Perfumes Collection"
SADAPAY_NUMBER="03001234567"
SADAPAY_IBAN="PK89SADA00000003001234567"
NAYAPAY_ACCOUNT_TITLE="Perfumes Collection"
NAYAPAY_NUMBER="03001234567"
NAYAPAY_ID="@perfumescollection"

# 3. JazzCash Merchant Gateway (Online Automated Checkout)
JAZZCASH_MERCHANT_ID="MC12345"
JAZZCASH_PASSWORD="your_jazzcash_merchant_password"
JAZZCASH_INTEGRITY_SALT="your_jazzcash_integrity_salt_32char"
JAZZCASH_SANDBOX=true

# 4. EasyPaisa Merchant Gateway (Online Automated Checkout)
EASYPAISA_STORE_ID="12345"
EASYPAISA_HASH_KEY="your_easypaisa_merchant_hash_key"
EASYPAISA_SANDBOX=true

# 5. Safepay Pakistani Card Payment Gateway (Visa / MasterCard / PayPak)
SAFEPAY_API_KEY="sec_sandbox_your_safepay_client_key"
SAFEPAY_SECRET_KEY="your_safepay_secret_key"
SAFEPAY_WEBHOOK_SECRET="whsec_your_safepay_webhook_secret"
SAFEPAY_SANDBOX=true
