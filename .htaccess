<IfModule mod_rewrite.c>
    RewriteEngine On

    # Prevent direct access to hidden files and directories (like .env, .git)
    RewriteRule (^|/)\.(?!well-known/) - [F]

    # Block access to critical system folders
    RewriteRule ^(app|bootstrap|config|database|resources|routes|storage|tests)/ - [F,L]

    # Force HTTPS on Hostinger
    RewriteCond %{HTTPS} off
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Route all requests to Laravel's public directory
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
